+    eval_path = _eval(tmp_path, get_model("mockllm/model", custom_outputs=outputs))
+    [jsonl] = (tmp_path / "runs").rglob("*.jsonl")
+    rf = load_run(jsonl, eval_path)
+    assert list(rf.turns["turn"]) == list(range(1, 10))
