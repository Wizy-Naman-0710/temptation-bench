+            return Path(p)
+    if st.get("log_path"):  # the batch was moved: look for runs/<run_id>/<name> inside it
+        want = Path(st["log_path"])
+        for p in batch_dir.rglob(want.name):
+            if p.parent.name == want.parent.name:
+                return p
+    return None
