+def _engine_sha():
+    h = hashlib.sha256()
+    for p in sorted(ENGINE.rglob("*.py"), key=lambda q: q.relative_to(ENGINE).as_posix()):
+        h.update(p.relative_to(ENGINE).as_posix().encode())
+        h.update(p.read_bytes())
+    return h.hexdigest()
