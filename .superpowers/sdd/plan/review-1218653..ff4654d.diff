+            "is_t1": a.is_t1,
+            "version": version,
+            "field": field,
+            "old": getattr(before, field),
+            "new": stored,
+            "reason": reason[:500],
+            "status": a.status,
+            "passed_before": pc_before["passed"],
+            "passed_after": pc_after["passed"],
+            "post_verification_edit": verified is not None,
