+
+def test_slips_cure_rate():
+    n = cured = 0
+    cfg = load_config("window")
+    for seed in range(1, 201):
+        for x in bk.build_inherited_book(seed, cfg):
+            if x.fraud:
+                continue
+            for _, ok in x.slips:
+                n += 1
