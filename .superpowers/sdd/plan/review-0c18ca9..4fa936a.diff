+    assert p.compose("T1", d8.msg_key, d8.facts, d8.draft + " Thanks.") == d8.draft + " Thanks."
+    reasons = [f["reason"] for f in p.take_fallbacks()]
+    assert reasons[0].startswith("rejected at pregen")
