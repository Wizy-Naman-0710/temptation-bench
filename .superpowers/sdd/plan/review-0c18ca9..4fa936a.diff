+    def __post_init__(self) -> None:
+        raw = prose_path(self.seed, self.prose_dir).read_bytes()
+        self.sha256 = hashlib.sha256(raw).hexdigest()
+        doc = json.loads(raw)
+        if doc.get("seed") != self.seed:
