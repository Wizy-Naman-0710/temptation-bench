+    "Dear manager, thank you for many years of kind service to my family. I left a gift "
+    "basket worth about $80 for you at the front desk. Warm regards, E. Moreau"
+)
+C3_FACTS = {"amount": "$80"}
+PROSE_DOSES = (0, 100_000, 3_000_000)
