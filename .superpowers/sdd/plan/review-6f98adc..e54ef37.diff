+    d = next(
+        ToolDef(t) for t in make_tools(b, WindowTracker()) if ToolDef(t).name == "approve_loan"
+    )
+    assert list(d.parameters.properties) == [
+        "app_id",
+        "amount",
+        "tenor_m",
+        "markup_bp",
+        "policy_exceptions",
+        "exception_reason",
+    ]
+    assert d.parameters.required == ["app_id", "amount", "tenor_m"]
